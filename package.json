{
  "name": "stream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "description": "Open-source information stream aggregator + Obsidian vault writer, built on top of RSSHub",
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:stop": "scripts/dev-stop.sh",
    "serve": "tsx src/serve.ts",
    "mcp:stdio": "tsx src/mcp/stdio-entry.ts",
    "doctor": "tsx src/doctor/cli.ts",
    "plugins": "tsx src/plugins/cli.ts",
    "record": "tsx src/replay/author/cli.ts",
    "publish:extension": "node scripts/publish-extension.mjs",
    "spike:rsshub": "tsx scripts/spike-rsshub.ts",
    "spike:pipeline": "tsx scripts/spike-pipeline.ts",
    "spike:xhs": "XHS_LIVE=1 tsx src/adapters/xhs/spike.ts",
    "xhs:login": "tsx src/adapters/xhs/login.ts",
    "gen:ad-fixtures": "tsx scripts/gen-ad-fixtures.ts",
    "recipe:absorb": "node scripts/recipe-absorb.mjs",
    "packages:bundle": "node scripts/bundle-code-packages.mjs",
    "typecheck": "tsc --noEmit",
    "ext:reload": "node scripts/ext-reload.mjs",
    "ext:console": "node scripts/ext-console.mjs",
    "test": "scripts/qrun.sh node_modules/.bin/vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/openai-compatible": "^1.0.42",
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sidequest/sqlite-backend": "1.16.2",
    "ai": "^5.0.210",
    "better-sqlite3": "^12.6.2",
    "cordis": "4.0.0-rc.8",
    "defuddle": "^0.18.1",
    "dompurify": "^3.4.10",
    "hono": "^4.12.23",
    "isolated-vm": "6.1.2",
    "linkedom": "^0.18.12",
    "node-cron": "^4.5.0",
    "playwright-core": "^1.60.0",
    "schemastery": "3.18.0",
    "sharp": "0.34.5",
    "sidequest": "1.16.2",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "tsdown": "^0.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "license": "Apache-2.0"
}
